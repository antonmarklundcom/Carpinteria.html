# ── Constructora Vera — Hostinger (hosting compartido, Apache) ──────
# Pensado para deploy por Git: el repo ENTERO termina en el directorio
# público, así que hay que bloquear lo que no es del sitio.

# ── Seguridad: nunca servir el repo ni la documentación ─────────────
# Sin esto, /BUILD-SPEC.md y /.git/config quedan públicos.
RedirectMatch 404 /\.git
<FilesMatch "\.(md|json|yml|yaml|sample)$">
    Require all denied
</FilesMatch>
<FilesMatch "^(\.htaccess|\.gitignore|\.env.*)$">
    Require all denied
</FilesMatch>

Options -Indexes
ServerSignature Off

# ── HTTPS forzado ───────────────────────────────────────────────────
# Comentar el bloque si el SSL del dominio temporal todavía no emitió.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

DirectoryIndex index.html index.php

# ── Cabeceras ───────────────────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# ── Compresión ──────────────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain
    AddOutputFilterByType DEFLATE application/javascript image/svg+xml
</IfModule>

# ── Caché ───────────────────────────────────────────────────────────
# El HTML NO se cachea: es una demo que cambia seguido y el prospecto
# tiene que ver la última versión sin limpiar el navegador.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>

AddDefaultCharset UTF-8
